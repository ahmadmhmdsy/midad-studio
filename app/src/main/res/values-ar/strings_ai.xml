    <!-- Human names for the models we ship; the manifest keeps the technical name. -->
    <string name="a_model_selfie_title">قصّ سريع للأشخاص</string>
    <string name="a_model_selfie_desc">النموذج الافتراضي. صغير وسريع والأنسب لشخص واحد في صورة شخصية.</string>
    <string name="a_model_selfie_landscape_title">قصّ سريع للصور العريضة</string>
    <string name="a_model_selfie_landscape_desc">القصّ السريع نفسه، مهيّأ للصور العريضة أو الأفقية.</string>
    <string name="a_model_multiclass_title">قصّ دقيق للأشخاص</string>
    <string name="a_model_multiclass_desc">يفصل الشعر والبشرة والملابس لحوافّ أنظف. تنزيل أكبر.</string>
    <string name="a_model_hair_title">قصّ الشعر فقط</string>
    <string name="a_model_hair_desc">يعزل الشعر وحده لإعادة تلوينه أو تنعيم الحواف.</string>
    <string name="a_model_deeplab_title">أجسام عامة (DeepLab)</string>
    <string name="a_model_deeplab_desc">يتعرّف على الحيوانات والمنتجات والأثاث والمركبات إضافة إلى الأشخاص. الأنسب للصور التي لا يكون موضوعها شخصًا.</string>
    <string name="a_model_modnet_title">قصّ بورتريه ناعم (MODNet)</string>
    <string name="a_model_modnet_desc">تفاصيل شعر وحوافّ ناعمة لقصّ بورتريه أنظف. تنزيل بحجم ٢٥ ميجابايت؛ الأنسب للأشخاص لا للأجسام العامة.</string>

    <!-- Model manager -->
    <string name="a_models_title">إدارة النماذج</string>
    <string name="a_models_intro">تعمل النماذج على هذا الجهاز بالكامل. تُنسخ النماذج المضمّنة من التطبيق عند أول استخدام ويُتحقَّق منها، وكذلك النماذج المنزَّلة: لا يحل النموذج الجديد محل القديم إلا بعد مطابقة بصمته. ولا يُستخدم الاتصال إلا عند بدء تنزيل.</string>
    <string name="a_models_download_note">تنزيل النماذج هو الاستخدام الوحيد للشبكة في مختبر الذكاء.</string>
